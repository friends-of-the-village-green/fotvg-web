# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# Source material — never commit
fotvg-drive-folders/
*.docx
*.xlsx
*.doc
*.xls

# Mock-ups — see decision 017.
# The originals embed real event photographs as base64. Attribution is unconfirmed,
# the children's permissions are not in writing, and git history is permanent — so
# they stay out of this public repository and live on John's machine and in FotVG's
# Drive. The *-no-photos.html copies keep the markup and alt text with the images
# replaced by grey placeholders, and those are safe to commit.
#
# Ignore the contents rather than the directory itself: git cannot re-include a
# file whose parent directory is excluded, so the negation below only works this way.
docs/mockups/*
!docs/mockups/*-no-photos.html

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.*
!.env.example
.netlify/
.claude/settings.local.json
CLAUDE.local.md

# macOS-specific files
.DS_Store

