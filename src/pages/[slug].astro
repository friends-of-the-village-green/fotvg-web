---
/**
 * A standing page: About, Get Involved, Contact, "What we're dreaming about".
 *
 * Anything an editor creates as a `page` document appears here, at the top
 * level — /about, /get-involved. No developer involvement, which is the point:
 * before this route existed, an editor could write a whole page, publish it,
 * and have it appear nowhere at all.
 *
 * ⚠️ Do not create a page with the slug `events` or `programs`. Those are real
 * routes in this folder and they win; the page document would silently never
 * render. Unlikely, but it is the one collision available here.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import RichText from '../components/RichText.astro'
import SanityImage from '../components/SanityImage.astro'
import {client} from '../lib/sanity.js'
import {allPageSlugsQuery, pageBySlugQuery} from '../lib/queries.js'

export async function getStaticPaths() {
  const slugs = await client.fetch(allPageSlugsQuery)

  /* Guard the collision the comment above warns about, rather than trusting
     nobody will ever do it. */
  const reserved = new Set(['events', 'past-events', 'programs', 'board'])

  return slugs
    .filter((slug) => !reserved.has(slug))
    .map((slug) => ({params: {slug}}))
}

const {slug} = Astro.params
const page = await client.fetch(pageBySlugQuery, {slug})

if (!page) {
  throw new Error(`No page found for slug "${slug}".`)
}
---

<BaseLayout
  title={page.title}
  description={page.seoDescription || page.summary}
  shareImage={page.image}
>
  <article>
    <section class="intro">
      <div class="wrap">
       <div class="prose">
        <h1 class="page-title">{page.title}</h1>
        <p class="summary">{page.summary}</p>
       </div>
      </div>
    </section>

    {page.image?.asset && (
      <div class="wrap">
        <figure>
          <SanityImage
            image={page.image}
            width={1200}
            aspect={3 / 2}
            sizes="(min-width: 68rem) 68rem, 100vw"
            loading="eager"
          />
          {page.image.credit && <figcaption>Photo: {page.image.credit}</figcaption>}
        </figure>
      </div>
    )}

    <section>
      <div class="wrap">
        <RichText value={page.body} />
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .intro {
    padding-block: var(--space-section) var(--space-l);
  }

  .summary {
    margin-top: var(--space-m);
    font-size: clamp(1.05rem, 2.5vw, 1.2rem);
    color: var(--color-text-muted);
  }

  figure {
    margin: 0;
  }

  figure :global(img) {
    border: 1px solid var(--color-rule);
    background: var(--color-bg-alt);
  }

  figcaption {
    margin-top: var(--space-xs);
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }
</style>
