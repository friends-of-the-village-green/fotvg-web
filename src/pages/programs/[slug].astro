---
/**
 * A program area page — one per program document (decision 011).
 *
 * The three areas are how the board thinks about its own work, and grant
 * applications are written per program, so each gets a real page with its
 * mission, vision and prose rather than a line on the home page.
 *
 * getStaticPaths builds one page per published program. If the dataset has
 * none, it builds nothing and the site still compiles — a build should not
 * fail because content has not been entered yet.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import NewsList from '../../components/NewsList.astro'
import RichText from '../../components/RichText.astro'
import SanityImage from '../../components/SanityImage.astro'
import {client} from '../../lib/sanity.js'
import {
  allProgramsQuery,
  programBySlugQuery,
  recentNewsByProgramQuery,
} from '../../lib/queries.js'

export async function getStaticPaths() {
  const programs = await client.fetch(allProgramsQuery)

  return programs.map((p) => ({params: {slug: p.slug}}))
}

const {slug} = Astro.params
const program = await client.fetch(programBySlugQuery, {slug})

/* getStaticPaths only produces slugs that exist, so this should be
   unreachable. Failing loudly beats rendering a page of blanks if it isn't. */
if (!program) {
  throw new Error(`No program found for slug "${slug}".`)
}

const hasMissionOrVision = Boolean(program.mission || program.vision)

/* Three is what fits on one row of cards at every width this page uses, and
   the rest are one click away. The page is about the program, not its news. */
const NEWS_LIMIT = 3

const news =
  program.newsCount > 0
    ? await client.fetch(recentNewsByProgramQuery, {program: slug, limit: NEWS_LIMIT})
    : []
---

<BaseLayout
  title={program.name}
  description={program.seoDescription || program.summary}
  shareImage={program.image}
>
  <article>
    <section class="intro">
      <div class="wrap">
        <p class="eyebrow">What we support</p>
        <h1 class="page-title">{program.name}</h1>
        <p class="summary">{program.summary}</p>
      </div>
    </section>

    {program.image?.asset && (
      <div class="wrap">
        <figure class="hero-figure">
          <SanityImage
            image={program.image}
            width={1200}
            aspect={3 / 2}
            sizes="(min-width: 68rem) 68rem, 100vw"
            loading="eager"
          />
          {(program.image.caption || program.image.credit) && (
            <figcaption>
              {program.image.caption}
              {program.image.caption && program.image.credit && (
                <span aria-hidden="true"> · </span>
              )}
              {program.image.credit && `Photo: ${program.image.credit}`}
            </figcaption>
          )}
        </figure>
      </div>
    )}

    <section>
      <div class="wrap">
        <RichText value={program.body} class="prose" />

        {hasMissionOrVision && (
          <div class="statements">
            {program.mission && (
              <div class="statement">
                <h2>Mission</h2>
                <p>{program.mission}</p>
              </div>
            )}
            {program.vision && (
              <div class="statement">
                <h2>Vision</h2>
                <p>{program.vision}</p>
              </div>
            )}
          </div>
        )}

        {/* Until now a program page described the work and showed none of it,
            which is a strange thing to hand a grant reviewer. The write-ups
            live on the filtered archive rather than being repeated here, so
            there is one list to maintain rather than two that drift.

            Only offered when there is something behind it — the page for a
            program with no write-ups is not generated at all, so linking
            unconditionally would 404. See programCountsQuery. */}
        {program.recapCount > 0 && (
          <p class="archive-link">
            <a href={`/past-events/${program.slug}`}>
              See what we've done for {program.name}
            </a>
          </p>
        )}
      </div>
    </section>

    {/**
     * The program's own news (decision 037).
     *
     * Recent articles rather than all of them, with the address of the full
     * list underneath. That link is offered whenever there is any news at all,
     * even when everything is already on screen: /programs/greenworks/news is a
     * page the board hands out, and it should be reachable from the program it
     * belongs to rather than only from a filter on /news.
     */}
    {news.length > 0 && (
      <section class="news-section">
        <div class="wrap">
          <h2>News</h2>

          {/* Level 3: these sit under the "News" heading above, which is itself
              under the page title. Skipping a level is what a screen reader
              user hears as a missing section. */}
          <NewsList items={news} level={3} />

          <p class="news-link">
            <a href={`/programs/${program.slug}/news`}>
              All {program.name} news
            </a>
          </p>
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .intro {
    padding-block: var(--space-section) var(--space-l);
  }

  .intro h1 {
    max-width: 18ch;
  }

  .summary {
    margin-top: var(--space-m);
    max-width: var(--width-prose);
    font-size: clamp(1.05rem, 2.5vw, 1.2rem);
    color: var(--color-text-muted);
  }

  .hero-figure {
    margin: 0;
  }

  /* :global, because the <img> is rendered by SanityImage and this file's
     scoped styles cannot reach it. Sizing lives in that component; only the
     decoration is ours. */
  .hero-figure :global(img) {
    border: 1px solid var(--color-rule);
    background: var(--color-bg-alt);
  }

  figcaption {
    margin-top: var(--space-xs);
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  .statements {
    display: grid;
    gap: var(--space-l);
    margin-top: var(--space-xl);
  }

  @media (min-width: 46rem) {
    .statements {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
    }
  }

  .statement {
    border-top: 2px solid var(--color-accent);
    padding-top: var(--space-m);
  }

  .statement h2 {
    font-size: 1.3rem;
    letter-spacing: -0.01em;
  }

  .statement p {
    margin-top: var(--space-xs);
    color: var(--color-text-muted);
  }

  .archive-link {
    margin-top: var(--space-xl);
    font-weight: 700;
  }

  .archive-link a {
    color: var(--color-accent);
    text-underline-offset: 4px;
  }

  /* Tinted, like the photographs on an event page, so the news reads as its own
     block rather than as more of the prose above it. */
  .news-section {
    background: var(--color-bg-alt);
  }

  .news-section h2 {
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    margin-bottom: var(--space-l);
  }

  .news-link {
    margin-top: var(--space-xl);
    font-weight: 700;
  }

  .news-link a {
    color: var(--color-accent);
    text-underline-offset: 4px;
  }
</style>
