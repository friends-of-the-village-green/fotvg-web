---
/**
 * What is coming up. Only that.
 *
 * This page used to carry the upcoming list *and* the whole archive, which is
 * why its heading had to be "What's on, and what we've done" — six words that
 * took three lines to say at the home page's heading size. The archive now
 * lives at /past-events, where it can be filtered, and this page does one job
 * (decision 031).
 *
 * The URL is unchanged, so the home page's "See all upcoming events" and any
 * link anyone has already shared still land somewhere sensible.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import EventRow from '../../components/EventRow.astro'
import {client} from '../../lib/sanity.js'
import {upcomingEventsQuery} from '../../lib/queries.js'

const upcoming = await client.fetch(upcomingEventsQuery)
---

<BaseLayout
  title="What's on"
  description="Concerts, work parties, classes, tours and sales coming up at the Village Green in Kingston, Washington."
>
  <section class="intro">
    <div class="wrap">
     <div class="prose">
      <h1 class="page-title">What's on</h1>
      <p class="lede">
        Concerts, work parties, classes, tours and sales. Everything here is at
        the Village Green, and everyone is welcome.
      </p>
     </div>
    </div>
  </section>

  <section class="list">
    <div class="wrap">
      {upcoming.length > 0 ? (
        <ul class="event-list" role="list">
          {upcoming.map((event) => <EventRow event={event} />)}
        </ul>
      ) : (
        <p class="empty">
          Nothing on the calendar just now. We usually add the summer concerts
          in spring and the work parties a few weeks ahead.
        </p>
      )}

      {/* A button, matching the home page and the event pages. It is the one
          thing to do at the bottom of this page. */}
      <p class="more">
        <a class="button" href="/past-events">
          See everything we've done
          <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    padding-block: var(--space-section) var(--space-l);
  }

  .lede {
    margin-top: var(--space-m);
    color: var(--color-text-muted);
    font-size: clamp(1.05rem, 2.5vw, 1.2rem);
  }

  .list {
    padding-top: 0;
  }

  .event-list {
    display: grid;
    gap: 0;
  }

  .empty {
    color: var(--color-text-muted);
    max-width: var(--width-prose);
  }

  .more {
    margin-top: var(--space-xl);
    font-weight: 700;
  }

</style>
