---
/**
 * Home page.
 *
 * Section order follows mock-up 2 (decision 010): the hero, the next thing
 * happening, what we have done, what is on, what we support, and how to give.
 *
 * Past write-ups come before upcoming events on purpose. The board's reason
 * for wanting them is grant applications, and a reviewer arriving from an
 * application should meet the evidence first (decision 008).
 *
 * Every section below the hero renders only if it has content. An empty
 * heading with nothing under it reads as a broken site, and this one gets
 * shown to funders.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Disambiguation from '../components/Disambiguation.astro'
import EventRow from '../components/EventRow.astro'
import GiveBand from '../components/GiveBand.astro'
import NextEventStrip from '../components/NextEventStrip.astro'
import RecapBand from '../components/RecapBand.astro'
import RichText from '../components/RichText.astro'
import SanityImage from '../components/SanityImage.astro'
import {client} from '../lib/sanity.js'
import {getSiteSettings} from '../lib/content.js'
import {
  allProgramsQuery,
  nextEventQuery,
  recentRecapsQuery,
  upcomingEventsQuery,
} from '../lib/queries.js'

const site = await getSiteSettings()

const [programs, nextEvent, recaps, upcoming] = await Promise.all([
  client.fetch(allProgramsQuery),
  client.fetch(nextEventQuery),
  client.fetch(recentRecapsQuery, {limit: 3}),
  client.fetch(upcomingEventsQuery),
])

/* Six rows is enough for a home page. The full list lives at /events. */
const upcomingShown = upcoming.slice(0, 6)

/**
 * Hero wording, from Site settings in the Studio (decision 023).
 *
 * The fallbacks below are the copy the board approved in August 2026, and they
 * live here rather than in the schema for two reasons. `initialValue` only
 * fires when a document is created, and this one already exists — so it would
 * never appear. And this is the file where the wording has to agree with the
 * design: the headline wraps at about sixteen characters, and the bold in the
 * introduction is doing a job (CLAUDE.md — say all-volunteer plainly).
 *
 * Clear a field in the Studio and the wording here comes back. That is the
 * intended behavior: the home page is never headless.
 */
const hero = site.home
---

<BaseLayout
  title="Friends of the Village Green · Kingston, Washington"
  description="An all-volunteer group in Kingston, Washington. We help pay for the arts program, the Greenworks community garden, and community projects at the Village Green."
>
  <section class="hero band">
    {/* Chosen by hand in Site settings, not picked automatically from the
        newest event — the board wanted control over the first thing a visitor
        sees. With none set, this falls back to mock-up 2's no-photo treatment,
        which is the reason that treatment exists. */}
    {site.heroImage?.asset ? (
      <>
        {/* Wrapped, because scoped styles here cannot reach an <img> that
            SanityImage renders. The wrapper is ours, so we can position it. */}
        <div class="hero-photo">
          <SanityImage
            image={site.heroImage}
            width={1600}
            aspect={16 / 9}
            sizes="100vw"
            loading="eager"
          />
        </div>
        <div class="hero-scrim" aria-hidden="true"></div>
      </>
    ) : (
      <div class="hero-texture" aria-hidden="true"></div>
    )}

    <div class="wrap">
      <p class="hero-label">
        {hero.eyebrow || 'Village Green Community Center · Kingston'}
      </p>

      <h1>{hero.heading || 'What we help make happen.'}</h1>

      {/* Wrapped, for the same reason the photograph above is: scoped styles
          here cannot reach markup that RichText renders. The wrapper is ours. */}
      <div class="hero-lede">
        {hero.lede ? (
          <RichText value={hero.lede} />
        ) : (
          <p>
            <b>Friends of the Village Green</b> is an <b>all-volunteer</b> group. We
            support some of what goes on at the Village Green Community Center — the
            arts program, the Greenworks community garden, and community projects
            like the Secret Garden Tour. We don't run or fund everything that
            happens here, and we hope to support more as Kingston grows.
          </p>
        )}
      </div>
    </div>
  </section>

  {nextEvent && <NextEventStrip event={nextEvent} />}

  {recaps.length > 0 && (
    <section id="done">
      <div class="wrap">
        <div class="sec-head prose">
          <p class="eyebrow">What we have been doing</p>
          <h2>What we've done</h2>
        </div>

        {recaps.map((event, i) => (
          <RecapBand event={event} flip={i % 2 === 1} />
        ))}

        <p class="more"><a href="/events">See everything we've done</a></p>
      </div>
    </section>
  )}

  {upcomingShown.length > 0 && (
    <section id="upcoming" class="upcoming">
      <div class="wrap">
        <div class="sec-head prose">
          <p class="eyebrow">Coming up</p>
          <h2>What's on</h2>
        </div>

        <ul class="event-list" role="list">
          {upcomingShown.map((event) => <EventRow event={event} />)}
        </ul>

        {upcoming.length > upcomingShown.length && (
          <p class="more"><a href="/events">See all upcoming events</a></p>
        )}
      </div>
    </section>
  )}

  {programs.length > 0 && (
    <section id="support">
      <div class="wrap">
        <div class="sec-head prose">
          <p class="eyebrow">Where the money goes</p>
          <h2>What we support</h2>
          <p class="section-lede">
            Plenty goes on at the Village Green that we have no hand in — these
            are the ones we help pay for and put volunteers behind.
          </p>
        </div>

        <ul class="supported" role="list">
          {programs.map((program) => (
            <li class="supported-item">
              <h3><a href={`/programs/${program.slug}`}>{program.name}</a></h3>
              <p>{program.summary}</p>
            </li>
          ))}

          {/* The closing card, from mock-up 2. It sits in the same grid as the
              program areas but is deliberately NOT one of them: no slug, no
              page, no link, and nothing an event can be attributed to. It says
              the list is expected to grow — see decision 027. */}
          <li class="supported-item supported-more">
            <h3>{hero.supportMoreHeading || 'And, we hope, more'}</h3>

            <div class="support-more-text">
              {hero.supportMoreText ? (
                <RichText value={hero.supportMoreText} />
              ) : (
                <p>
                  We want to facilitate and support more activities and more
                  community engagement, to meet the needs of a changing and
                  growing Kingston.
                </p>
              )}
            </div>
          </li>
        </ul>
      </div>
    </section>
  )}

  <GiveBand site={site} />

  <section class="disambiguation-section">
    <div class="wrap">
      <Disambiguation site={site} />
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- hero ---------- */
  .hero {
    position: relative;
  }

  .hero-texture {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 90% at 78% 15%, rgba(217, 182, 95, 0.22), transparent 60%),
      repeating-linear-gradient(115deg, rgba(255, 255, 255, 0.045) 0 2px, transparent 2px 22px);
  }

  .hero-photo {
    position: absolute;
    inset: 0;
  }

  /* Overrides SanityImage's own width/height, which suit an image in the flow
     rather than one filling a band. `object-position` sits the crop slightly
     low, keeping faces in frame when the band is short on a phone. */
  .hero-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
  }

  /* Without this the headline sits on the photograph and neither is legible.
     Weighted to the left, where the text is, so the right of the picture stays
     visible. The colour is the band green at high opacity, so the hero still
     reads as one panel rather than a photo with a grey sheet over it. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgba(9, 26, 20, 0.92) 0%, rgba(9, 26, 20, 0.78) 45%, rgba(9, 26, 20, 0.45) 100%),
      linear-gradient(to top, rgba(9, 26, 20, 0.7), transparent 55%);
  }

  .hero .wrap {
    position: relative;
    padding-block: clamp(4rem, 14vw, 8rem);
  }

  .hero-label {
    font-size: 0.7rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-band-accent);
    margin-bottom: 1.25rem;
  }

  .hero h1 {
    max-width: 16ch;
  }

  .hero-lede {
    margin-top: var(--space-l);
    max-width: 34rem;
    font-size: clamp(1.05rem, 2.5vw, 1.2rem);
    color: var(--color-band-text-muted);
  }

  /* The paragraph inside is either the fallback written above or Portable Text
     from the Studio. RichText caps prose at --width-prose and puts a margin on
     every paragraph, both of which are wrong in a hero — so they are overridden
     here.

     The `.hero` prefix is not decoration. Astro compiles `.hero-lede :global(p)`
     to the same specificity as RichText's own `.rich-text :global(p)`, and which
     one wins would then come down to the order the two components' styles happen
     to be bundled in. The extra class settles it. */
  .hero .hero-lede :global(p) {
    max-width: none;
    margin-top: var(--space-s);
  }

  .hero .hero-lede :global(p:first-child) {
    margin-top: 0;
  }

  /* `b` is the fallback's markup; `strong` is what the Studio's Bold button
     produces. Both get the same treatment. */
  .hero-lede :global(b),
  .hero-lede :global(strong) {
    color: var(--color-band-text);
    font-weight: 600;
  }

  /* ---------- shared section furniture ---------- */
  .sec-head {
    margin-bottom: 2.5rem;
  }

  .section-lede {
    margin-top: 0.9rem;
    color: var(--color-text-muted);
    font-size: 1.05rem;
  }

  .more {
    margin-top: var(--space-l);
    font-weight: 700;
  }

  .more a {
    color: var(--color-accent);
    text-underline-offset: 4px;
  }

  /* ---------- what's on ---------- */
  .upcoming {
    background: var(--color-bg-alt);
  }

  .event-list {
    display: grid;
    gap: 0;
  }

  /* ---------- what we support ---------- */
  .supported {
    display: grid;
    gap: var(--space-xl);
    margin-top: var(--space-xl);
  }

  @media (min-width: 46rem) {
    .supported {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem 3rem;
    }
  }

  .supported-item {
    border-top: 2px solid var(--color-accent);
    padding-top: var(--space-m);
  }

  .supported-item h3 {
    font-size: 1.3rem;
  }

  .supported-item h3 a {
    text-decoration: none;
  }

  .supported-item h3 a:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .supported-item p {
    margin-top: var(--space-xs);
    color: var(--color-text-muted);
    font-size: 0.98rem;
  }

  /* Same treatment for the closing card, whose paragraph may come from
     RichText. The `.supported` prefix outruns RichText's own `p` rule, which
     would otherwise tie on specificity and be settled by bundle order. */
  .supported .support-more-text :global(p) {
    margin-top: var(--space-xs);
    color: var(--color-text-muted);
    font-size: 0.98rem;
    max-width: none;
  }

  /* ---------- disambiguation ---------- */
  .disambiguation-section {
    padding-block: var(--space-section);
  }
</style>
