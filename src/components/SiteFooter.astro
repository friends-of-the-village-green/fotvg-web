---
/**
 * Site footer: contact details and corporate status.
 *
 * The "three organizations share the name" explanation used to live down here,
 * quietly. It does not anymore — Betsy asked for it to be louder, so it is now
 * a card in the page flow (see Disambiguation.astro and decision 010).
 */
const {site} = Astro.props

const socialLabels = {
  facebook: 'Facebook',
  instagram: 'Instagram',
  youtube: 'YouTube',
}
---

<footer class="site-footer">
  <div class="wrap">
    <p class="address">{site.address}</p>

    <p class="meta">
      {site.email
        ? <a href={`mailto:${site.email}`}>Email us</a>
        : <span class="tk">[TK: public email address]</span>
      }
      <span aria-hidden="true"> · </span>
      Washington nonprofit corporation, founded {site.founded}
    </p>

    {site.socialLinks.length > 0 && (
      <ul class="social" role="list">
        {site.socialLinks.map((link) => (
          <li>
            <a href={link.url}>{socialLabels[link.platform] || link.platform}</a>
          </li>
        ))}
      </ul>
    )}
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-xl);
    border-top: 1px solid var(--color-rule);
    color: var(--color-text-muted);
    font-size: 0.88rem;
  }

  .address {
    color: var(--color-text);
  }

  .meta {
    margin-top: var(--space-2xs);
  }

  .social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    margin-top: var(--space-m);
  }

  .social a {
    /* 44px tap target, and enough space between them that a thumb does not
       hit the wrong one. */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    text-underline-offset: 3px;
  }
</style>
