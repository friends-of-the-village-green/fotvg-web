---
/**
 * Site footer: where else to go, how to reach us, and corporate status.
 *
 * The "three organizations share the name" explanation used to live down here,
 * quietly. It does not anymore — Betsy asked for it to be louder, so it is now
 * a card in the page flow (see Disambiguation.astro and decision 010).
 *
 * Two labeled columns rather than a strip of loose links, and each one sits
 * under the brass rule the rest of the site uses above a heading. That is what
 * makes a footer holding a single link — which is what this one holds today,
 * because no standing pages have been written yet — read as designed rather
 * than as an offcut. See decision 024.
 */
import {getFooterLinks} from '../lib/content.js'
import {newTabNote} from '../lib/links.js'

const {site} = Astro.props

const pages = await getFooterLinks()

const socialLabels = {
  facebook: 'Facebook',
  instagram: 'Instagram',
  youtube: 'YouTube',
}
---

<footer class="site-footer">
  <div class="wrap">
    <div class="cols">
      {pages.length > 0 && (
        <nav class="col" aria-labelledby="footer-more">
          <h2 class="eyebrow" id="footer-more">More about us</h2>

          <ul class="links" role="list">
            {pages.map((page) => (
              <li><a href={page.href}>{page.title}</a></li>
            ))}
          </ul>
        </nav>
      )}

      <div class="col">
        <h2 class="eyebrow">Find us</h2>

        <p class="address">{site.address}</p>

        {/* New tab, for the same reason as the volunteering button in
            GiveBand.astro — a webmail handler would otherwise take the whole
            window to a compose screen. */}
        <p class="contact">
          {site.email
            ? <a href={`mailto:${site.email}`} target="_blank" rel="noopener">
                Email us
                <span class="visually-hidden">{newTabNote()}</span>
              </a>
            : <span class="tk">[TK: public email address]</span>
          }
        </p>

        {site.socialLinks.length > 0 && (
          <ul class="social" role="list">
            {site.socialLinks.map((link) => (
              <li>
                <a href={link.url} target="_blank" rel="noopener">
                  {socialLabels[link.platform] || link.platform}
                  <span class="visually-hidden">{newTabNote()}</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>

    <p class="legal">
      Washington nonprofit corporation, founded {site.founded}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-xl);
    border-top: 1px solid var(--color-rule);
    color: var(--color-text-muted);
    font-size: 0.88rem;
  }

  .cols {
    display: grid;
    gap: var(--space-l) var(--space-xl);
  }

  /* Two columns from the width at which the board grid also goes two-up, so
     the footer changes shape at the same place as the page above it. */
  @media (min-width: 40rem) {
    .cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* The brass rule above a heading is the site's signature — it carries "What
     we support" on the home page and every name on the board page. Repeating
     it here is the whole point: the footer becomes the last two items in that
     sequence rather than a separate thing bolted underneath. */
  .col {
    border-top: 2px solid var(--color-accent);
    padding-top: var(--space-m);
  }

  .col .eyebrow {
    margin-bottom: var(--space-s);
  }

  .links li + li {
    margin-top: var(--space-2xs);
  }

  .links a {
    /* 44px minimum tap target, WCAG 2.5.8 — and the stacked layout gives them
       room to be that tall without two links crowding one thumb. */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    color: var(--color-text);
    text-underline-offset: 3px;
  }

  .address {
    color: var(--color-text);
  }

  .contact {
    margin-top: var(--space-xs);
  }

  .contact a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    text-underline-offset: 3px;
  }

  .social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
  }

  .social a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    text-underline-offset: 3px;
  }

  /* Below a hairline, away from the links — it is a legal statement, not
     navigation, and the separation says so without needing smaller type. */
  .legal {
    margin-top: var(--space-l);
    padding-top: var(--space-m);
    border-top: 1px solid var(--color-rule);
  }
</style>
