---
/**
 * Donate and Volunteer, on the dark green band.
 *
 * The Donate half renders only when there is a real Square link in Site
 * settings. A button that goes nowhere is worse than no button — it costs the
 * click *and* the trust. Same for the volunteer email.
 *
 * No card details ever touch this site; Square handles the whole transaction
 * (decision 007).
 *
 * Both halves of the copy are editable in the Studio (decision 027). The
 * fallbacks below are the board-approved wording, and an empty field puts them
 * back — the band is never headless. What is *not* editable is the Donate
 * button, the Square link and the tax note: a button and a statement of
 * corporate status are not marketing copy, and neither should be a typo away
 * from breaking.
 *
 * The money half runs reason → ask → action → other ways to do the same thing
 * → what FotVG is. The invitation to cover the card fee therefore sits above
 * the button, where it is still part of the ask; the program links and the
 * check address sit below it, where they are variations on an action the reader
 * has already decided to take.
 *
 * The fee sentence and the check sentence are separate Studio fields rather
 * than extra paragraphs of the appeal above. They say different things, and
 * keeping them apart means neither can be lost by an editor rewriting the
 * paragraph they would otherwise have been buried in.
 */
import RichText from './RichText.astro'

const {site} = Astro.props

const hasDonate = Boolean(site.donateUrl)
const hasEmail = Boolean(site.email)

const give = site.give ?? {}

/**
 * One Square link per program, so a donor can direct a gift without typing
 * anything and the treasurer can tell the funds apart in Square's own report
 * (board decision, 18 August 2026). Empty is the normal case and renders
 * nothing at all.
 */
const programLinks = site.programDonateLinks ?? []

/**
 * While the Square link is still being chased, the Donate half renders with a
 * dead placeholder in place of the button, so the section can be reviewed at
 * full height instead of collapsing to half a band.
 *
 * It is deliberately not a link. Not a `<a href="#">`, not a disabled-looking
 * anchor that still does something — a plain element that cannot be clicked,
 * carrying a [TK] marker, so nobody can mistake it for a working donate flow
 * or ship it by accident.
 *
 * ⚠️ THIS MUST NOT REACH THE PUBLIC SITE. Search the repository for "TK"
 * before the switchover to fotvg.org.
 */
const showDonatePlaceholder = !hasDonate
---

{(hasDonate || showDonatePlaceholder || hasEmail) && (
  <section id="give" class="band">
    <div class="wrap">
      <div class="give-grid">
        {(hasDonate || showDonatePlaceholder) && (
          <div>
            <p class="eyebrow">Money</p>
            <h2>{give.donateHeading || 'Donate'}</h2>

            {/* Wrapped: scoped styles here cannot reach markup that RichText
                renders. The wrapper is ours. */}
            <div class="give-text">
              {give.donateText ? (
                <RichText value={give.donateText} />
              ) : (
                <p>
                  A donation pays a musician, buys seed and timber for a garden bed,
                  or helps put on the rummage sale. We are an all-volunteer
                  organization — no paid staff, no office, no one drawing a salary —
                  so what you give goes to the program.
                </p>
              )}
            </div>

            {/* The fee ask, agreed by the board on 18 August 2026. Square takes
                3.3% + 30¢ on the free plan, which lands between 3.6% and 4.5%
                on the amounts people actually give, so "about 4%" is fair. The
                worked examples are the point: "add a few dollars" is 12% of a
                $25 gift and almost nothing on $500. */}
            <div class="give-text">
              {give.donateFeeText ? (
                <RichText value={give.donateFeeText} />
              ) : (
                <p>
                  Card processing takes about 4% of every donation. If you'd like to
                  cover that, add about 4% to your gift — a dollar on $25, four on
                  $100.
                </p>
              )}
            </div>

            {hasDonate ? (
              <a class="button" href={site.donateUrl}>
                Donate
                <span aria-hidden="true">↗</span>
                <span class="visually-hidden">(opens Square, our card processor)</span>
              </a>
            ) : (
              <p class="button button--placeholder" aria-disabled="true">
                Donate — link pending
              </p>
            )}

            {/* A list rather than links strung together with a middot: the
                separator is punctuation a screen reader reads aloud, and a list
                announces how many there are before the reader commits to one.
                The label names the list rather than floating above it
                unattached. */}
            {programLinks.length > 0 && (
              <div class="programs">
                <p id="give-programs">Or give to a particular program:</p>
                <ul aria-labelledby="give-programs">
                  {programLinks.map((link) => (
                    <li>
                      <a href={link.url}>
                        {link.program}
                        <span class="visually-hidden">(opens Square, our card processor)</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {/* Set larger than the tax note below it on purpose: this is an
                address somebody has to copy down by hand, and this audience
                skews older. */}
            <div class="give-text alternatives">
              {give.donateByCheck ? (
                <RichText value={give.donateByCheck} />
              ) : (
                <p>
                  Prefer not to use a card? A check avoids the fee altogether. Make it
                  out to Friends of the Village Green and mail it to 26159 Dulay Road
                  NE, Kingston, WA 98346.
                </p>
              )}
            </div>

            {/* Deliberately not editable in the Studio. This is a statement of
                corporate status, not copy — FotVG's 501(c)(3) determination was
                received in 2025 (docs/organization.md). The EIN stays off the
                site; it is listed there as not for publication. */}
            <p class="fine">
              Donations are handled by Square. Friends of the Village Green is a
              501(c)(3) nonprofit, so your donation is tax-deductible.
              {showDonatePlaceholder && (
                <span class="tk">[TK: Square donation URL — button is not live]</span>
              )}
            </p>
          </div>
        )}

        {hasEmail && (
          <div>
            <p class="eyebrow">Time</p>
            <h2>{give.volunteerHeading || 'Volunteer'}</h2>

            <div class="give-text">
              {give.volunteerText ? (
                <RichText value={give.volunteerText} />
              ) : (
                <p>
                  Wednesday mornings in the garden. An hour on the front table at
                  Discover Kingston. Sorting donations for the rummage sale. Setting
                  out chairs before a concert, and stacking them after. Tell us what
                  you'd enjoy and we'll find you something.
                </p>
              )}
            </div>
            <a class="button button--ghost" href={`mailto:${site.email}?subject=Volunteering`}>
              Email us about volunteering
            </a>
          </div>
        )}
      </div>
    </div>
  </section>
)}

<style>
  .give-grid {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 48rem) {
    .give-grid {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  h2 {
    font-size: 1.6rem;
    letter-spacing: -0.015em;
  }

  p {
    margin-top: 0.9rem;
    color: var(--color-text-muted);
  }

  /* The paragraph is either the fallback written above or Portable Text from
     the Studio. RichText caps prose at --width-prose and puts a margin on every
     paragraph; inside a two-column band the column is already the measure.

     The `.give-grid` prefix is not decoration. Astro compiles the shorter
     selector to the same specificity as RichText's own `.rich-text :global(p)`,
     and which one wins would come down to the order the two components' styles
     happen to be bundled in. The extra class settles it. */
  .give-grid .give-text :global(p) {
    margin-top: 0.9rem;
    max-width: none;
    color: var(--color-text-muted);
  }

  .give-grid .give-text :global(strong) {
    color: var(--color-band-text);
    font-weight: 700;
  }

  /* Under the button: the same card payment, pointed at one program. */
  .programs {
    margin-top: 1.2rem;
    /* em, not rem. The root is 16px and body text is 18px, so a rem value
       here would land at 14.7px — small for an audience that skews older.
       Sizing against the band text keeps it a step down from 18px, not two. */
    font-size: 0.92em;
  }

  .programs p {
    margin: 0;
    color: var(--color-text-muted);
  }

  /* Laid out with a gap rather than separators, so nothing is read aloud
     between the links and they wrap tidily on a phone. */
  .programs ul {
    list-style: none;
    margin: 0.2rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    /* The row gap is for the narrow-screen case, where the links stack: two
       underlined lines touching each other are easy to mis-tap. */
    gap: 0.2rem 1.2rem;
  }

  /* Inline-block with vertical padding, so each link clears the 24px minimum
     target size with room to spare — these sit close together, and the reader
     is likely to be on a phone. */
  .programs a {
    display: inline-block;
    padding-block: 0.3rem;
    color: var(--color-band-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Checks, which cost FotVG nothing — the reason it sits directly under the
     fee sentence's consequences. */
  .alternatives {
    margin-top: 1rem;
    font-size: 0.92em;
  }

  /* Three classes, so it plainly outranks the `.give-grid .give-text
     :global(p)` rule above rather than depending on which came first. */
  .give-grid .give-text.alternatives :global(p) {
    margin-top: 0;
  }

  .fine {
    font-size: 0.84rem;
  }

  /* Looks like the button so the layout can be judged, but is plainly not one:
     outlined rather than filled, dimmed, and with the cursor a browser uses
     for something unavailable. */
  .button--placeholder {
    background: transparent;
    color: var(--color-band-text-muted);
    border: 2px dashed var(--color-band-text-muted);
    cursor: not-allowed;
    margin-top: 1.4rem;
  }
</style>
