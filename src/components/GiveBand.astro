---
/**
 * Donate and Volunteer, on the dark green band.
 *
 * The Donate half renders only when there is a real Square link in Site
 * settings. A button that goes nowhere is worse than no button — it costs the
 * click *and* the trust. Same for the volunteer email.
 *
 * No card details ever touch this site; Square handles the whole transaction
 * (decision 007).
 */
const {site} = Astro.props

const hasDonate = Boolean(site.donateUrl)
const hasEmail = Boolean(site.email)

/**
 * While the Square link is still being chased, the Donate half renders with a
 * dead placeholder in place of the button, so the section can be reviewed at
 * full height instead of collapsing to half a band.
 *
 * It is deliberately not a link. Not a `<a href="#">`, not a disabled-looking
 * anchor that still does something — a plain element that cannot be clicked,
 * carrying a [TK] marker, so nobody can mistake it for a working donate flow
 * or ship it by accident.
 *
 * ⚠️ THIS MUST NOT REACH THE PUBLIC SITE. Search the repository for "TK"
 * before the switchover to fotvg.org.
 */
const showDonatePlaceholder = !hasDonate
---

{(hasDonate || showDonatePlaceholder || hasEmail) && (
  <section id="give" class="band">
    <div class="wrap">
      <div class="give-grid">
        {(hasDonate || showDonatePlaceholder) && (
          <div>
            <p class="eyebrow">Money</p>
            <h2>Donate</h2>
            <p>
              A donation pays a musician, buys seed and timber for a garden bed,
              or helps put on the rummage sale. We are an all-volunteer
              organization — no paid staff, no office, no one drawing a salary —
              so what you give goes to the program.
            </p>

            {hasDonate ? (
              <a class="button" href={site.donateUrl}>
                Donate
                <span aria-hidden="true">↗</span>
                <span class="visually-hidden">(opens Square, our card processor)</span>
              </a>
            ) : (
              <p class="button button--placeholder" aria-disabled="true">
                Donate — link pending
              </p>
            )}

            <p class="fine">
              Donations are handled by Square.
              {showDonatePlaceholder && (
                <span class="tk">[TK: Square donation URL — button is not live]</span>
              )}
              <span class="tk">[TK: confirm tax-deductibility wording with the board]</span>
            </p>
          </div>
        )}

        {hasEmail && (
          <div>
            <p class="eyebrow">Time</p>
            <h2>Volunteer</h2>
            <p>
              Wednesday mornings in the garden. An hour on the front table at
              Discover Kingston. Sorting donations for the rummage sale. Setting
              out chairs before a concert, and stacking them after. Tell us what
              you'd enjoy and we'll find you something.
            </p>
            <a class="button button--ghost" href={`mailto:${site.email}?subject=Volunteering`}>
              Email us about volunteering
            </a>
          </div>
        )}
      </div>
    </div>
  </section>
)}

<style>
  .give-grid {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 48rem) {
    .give-grid {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  h2 {
    font-size: 1.6rem;
    letter-spacing: -0.015em;
  }

  p {
    margin-top: 0.9rem;
    color: var(--color-text-muted);
  }

  .fine {
    font-size: 0.84rem;
  }

  /* Looks like the button so the layout can be judged, but is plainly not one:
     outlined rather than filled, dimmed, and with the cursor a browser uses
     for something unavailable. */
  .button--placeholder {
    background: transparent;
    color: var(--color-band-text-muted);
    border: 2px dashed var(--color-band-text-muted);
    cursor: not-allowed;
    margin-top: 1.4rem;
  }
</style>
