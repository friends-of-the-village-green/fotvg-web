---
/**
 * "Three organizations share the Village Green name."
 *
 * This is the single easiest thing for a visitor — or a grant reviewer — to
 * get wrong, and the board is acutely aware of it. In mock-up 2 it was quiet
 * footer text. Betsy asked for the prominence it had in mock-up 3: its own
 * bordered card, with a heading, in the flow of the page. That is decision 010,
 * and it is the one element carried across from a retired mock-up.
 *
 * The wording is editable in the Studio as of decision 027, at the board's
 * request. That is the one field on this site where an edit can say something
 * untrue about *another* organization: who owns the land, who owns the building
 * and who supports the programs are three different bodies, and the distinction
 * is legally and politically real. The Studio field carries that warning, and
 * `docs/organization.md` is the source of truth.
 *
 * The fallback below is the checked wording, so clearing the field restores it
 * rather than emptying the card.
 */
import RichText from './RichText.astro'

const {site} = Astro.props

const heading =
  site?.home?.disambiguationHeading || 'Three organizations share the Village Green name'
const body = site?.home?.disambiguationText || null
---

<aside class="disambiguation" aria-labelledby="disambiguation-heading">
  <h2 id="disambiguation-heading">{heading}</h2>

  {/* Wrapped: scoped styles here cannot reach markup that RichText renders. */}
  <div class="disambiguation-text">
    {body ? (
      <RichText value={body} />
    ) : (
      /* Keep each <b> on the same line as the word before it. A line break
         directly before a tag is collapsed away, which silently glues the words
         together — "The<b>Village Green Foundation</b>". */
      <p>
        The <b>Metropolitan Park District</b> owns the land.
        The <b>Village Green Foundation</b> owns the building.
        We are <b>Friends of the Village Green</b>, an all-volunteer group that
        supports some of the programs and the people who run them. We do not run
        the Community Center.
      </p>
    )}
  </div>
</aside>

<style>
  .disambiguation {
    max-width: var(--width-prose);
    border: 1px solid var(--color-rule);
    border-left: 4px solid var(--color-accent);
    padding: var(--space-l);
    background: var(--color-bg-alt);
  }

  /* Smaller than a section heading — this is an aside, not a chapter. The
     element is still an h2 so the document outline stays correct. */
  .disambiguation h2 {
    font-size: 1.15rem;
    line-height: 1.3;
    letter-spacing: 0;
  }

  /* Covers the fallback paragraph above and Portable Text from the Studio
     alike. The `.disambiguation` prefix outruns RichText's own `p` rule, which
     would otherwise tie on specificity and be settled by bundle order. */
  .disambiguation .disambiguation-text :global(p) {
    font-family: var(--font-display);
    font-size: 1.02rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    margin-top: var(--space-s);
    max-width: none;
  }

  /* `b` is the fallback's markup, `strong` is what the Studio's Bold button
     produces. 700 because the display stack has no 600 — see global.css. */
  .disambiguation .disambiguation-text :global(b),
  .disambiguation .disambiguation-text :global(strong) {
    color: var(--color-text);
    font-weight: 700;
  }
</style>
