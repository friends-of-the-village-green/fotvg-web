---
/**
 * Filter a list by program area. Used by the write-up archive and by the news
 * list, which is why the addresses are passed in rather than built here.
 *
 * These are ordinary links to ordinary pages, not a script that hides rows
 * (decision 031). It costs a few more generated pages and buys: it works with
 * JavaScript off and on a bad rural connection, every filter is a real address
 * that can go in a grant application, the back button behaves, and a screen
 * reader gets plain navigation rather than a list that silently changes under
 * it.
 *
 * Only programs that have something behind them are passed in — the page for a
 * program with nothing in it is never generated, so no filter can lead
 * somewhere empty. See programCountsQuery.
 *
 * `current` is the slug of the program being shown, or null on the unfiltered
 * page. The two href props default to the write-up archive, which is where this
 * component started and still the only caller that does not pass them.
 */
const {
  programs,
  current = null,
  allHref = '/past-events',
  hrefFor = (program) => `/past-events/${program.slug}`,
} = Astro.props
---

<nav class="filter" aria-label="Filter by program area">
  {/* The class is not decoration. global.css strips list markers and padding
      with `ul[class]` — a styled list is expected to carry one — so a classed
      list is the only kind that loses its bullets. Without it this rendered
      with markers and a 40px indent.

      `role="list"` stays alongside it: once list-style is none, Safari drops
      list semantics for VoiceOver, and the role puts them back. */}
  <ul class="filter-list" role="list">
    {/* aria-current tells a screen reader which one is showing. The fill does
        the same job visually; neither is doing it alone. */}
    <li>
      <a href={allHref} aria-current={current === null ? 'page' : undefined}>
        Everything
      </a>
    </li>

    {programs.map((program) => (
      <li>
        <a
          href={hrefFor(program)}
          aria-current={current === program.slug ? 'page' : undefined}
        >
          {program.name}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .filter-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .filter a {
    display: flex;
    align-items: center;

    /* 44px, the WCAG 2.5.8 minimum. This audience taps with thumbs, and a long
       program name already wraps to its own line on a phone — there is no
       reason to make these small. */
    min-height: 44px;
    padding: var(--space-xs) var(--space-m);

    border: 1px solid var(--color-rule);
    color: var(--color-text);
    text-decoration: none;
    font-size: 0.92rem;
    line-height: 1.2;
  }

  .filter a:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* The one that is showing. Filled rather than merely tinted, so the
     difference between selected and not is obvious rather than a shade —
     #7a5d18 against the page background is 5.7:1 either way round. */
  .filter a[aria-current='page'] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-bg);
    font-weight: 700;
  }
</style>
