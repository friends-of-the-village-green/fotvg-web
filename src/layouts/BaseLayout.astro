---
/**
 * The only page shell on this site.
 *
 * Everything a page must not be allowed to forget lives here: the title, the
 * description, the canonical URL, the Open Graph tags, the skip link, the
 * header and the footer. A page supplies a title and a description and gets
 * the rest for free.
 *
 * Most of this site's traffic arrives from links shared on Facebook and
 * Nextdoor, so the Open Graph tags are not an afterthought — they are how a
 * neighbor decides whether to tap.
 */
import '../styles/global.css'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import {getNav, getSiteSettings} from '../lib/content.js'
import {urlFor} from '../lib/sanity.js'

/* Fetched once for the whole build, not once per page — see lib/content.js. */
const site = await getSiteSettings()
const nav = await getNav()

const {
  title,
  description,
  /**
   * A Sanity image to use as the link preview — pass the page's own
   * photograph. Falls back to the default set in Site settings. Omitted
   * entirely if neither exists; a broken og:image is worse than none.
   */
  shareImage,
} = Astro.props

/* astro.config.mjs sets build.format: 'file', so at build time the pathname
   here is '/index.html' or '/404.html' — not the URL a visitor sees. Strip the
   extension before using it for anything public, or the canonical tag and the
   Open Graph URL advertise an address with .html on the end. */
const pathname = Astro.url.pathname
  .replace(/index\.html$/, '')
  .replace(/\.html$/, '')

/* Astro.site is set in astro.config.mjs. It is the test domain today and
   becomes fotvg.org at switchover — decision 015. Canonical URLs and the
   sitemap both follow it, so it is the one thing that must change then. */
const canonical = new URL(pathname, Astro.site)

/**
 * The link preview image.
 *
 * Most of this site's traffic arrives from links shared on Facebook and
 * Nextdoor, where the picture is most of what decides whether a neighbor taps.
 * A page's own photograph beats a generic one, so an event or program passes
 * its image and only falls back to the site default.
 *
 * 1200x630 is the size the social networks crop to. Producing it here means
 * editors never have to think about dimensions — they upload a photograph and
 * the right shape is derived.
 */
const ogImage = shareImage?.asset ? shareImage : site.shareImage?.asset ? site.shareImage : null

const shareImageUrl = ogImage
  ? urlFor(ogImage).width(1200).height(630).fit('crop').auto('format').url()
  : null

/* The home page title stands alone. Every other page is suffixed, so a
   browser tab or a search result says which site it belongs to. */
const isHome = pathname === '/'
const fullTitle = isHome ? title : `${title} · ${site.name}`
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {shareImageUrl && (
      <>
        <meta property="og:image" content={shareImageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        {ogImage.alt && <meta property="og:image:alt" content={ogImage.alt} />}
      </>
    )}
    <meta name="twitter:card" content={shareImageUrl ? 'summary_large_image' : 'summary'} />

    {/* The board decided against a logo, so the tab icon is the abbreviation
        set in type. See public/favicon.svg. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta name="generator" content={Astro.generator} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <SiteHeader site={site} nav={nav} />

    <main id="main">
      <slot />
    </main>

    <SiteFooter site={site} />
  </body>
</html>
