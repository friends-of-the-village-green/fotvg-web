# Copy to .env for local development. Never commit .env.
#
# In practice you do not need any of this. The `production` dataset is public
# and the project ID is not a secret, so src/lib/sanity.js has both as working
# defaults and the site builds with no configuration at all — locally and on
# Netlify. See decision 019.
#
# These exist only to point a build at a different project or dataset, which
# you would want if you ever set up a staging dataset.

# Not secret. The project ID ships in the browser bundle of every Sanity site.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=

# Not currently used, and not needed while the dataset is public.
#
# If the dataset is ever made private, the site build will need a token here
# and the same value set in Netlify's environment variables UI.
#
# SECRET if you add one. Viewer scope only — NEVER a write token. The site
# reads; writing happens in the Studio, by humans.
SANITY_API_READ_TOKEN=
